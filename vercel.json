{
    "version": 2,
    "functions":
        {  
            "index.py": {
            "runtime": "@vercel/python"
            }
        },

    "builds": [
        {  
            "src": "*.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "index.py"
        }
    ]
}